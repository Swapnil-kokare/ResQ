# ResQ Frontend Environment Variables
# If deploying frontend and backend to different domains (e.g. Vercel + Render):
# Set VITE_API_BASE_URL to your deployed backend API URL, e.g. https://resq-backend.onrender.com/api
# Leave empty or omit when running locally with Vite proxy or in unified Docker deployment.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
